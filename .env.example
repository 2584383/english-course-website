# =============================================================================
# Supabase — base de données, authentification et stockage
# Dashboard : https://supabase.com/dashboard → Project Settings → API
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# Clé de service : contourne la RLS. Jamais exposée au navigateur.
# Requise pour : invitation d'utilisateurs, webhook Calendly, cron de rappels,
# suppression de compte (RGPD).
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# =============================================================================
# Application
# =============================================================================
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# =============================================================================
# Calendly — moteur de réservation et génération des liens Google Meet
# =============================================================================
# URL publique du type d'événement (ex. https://calendly.com/lea/cours-anglais-1h)
NEXT_PUBLIC_CALENDLY_EVENT_URL=""

# Jeton d'API personnel — https://calendly.com/integrations/api_webhooks
# Sert à créer l'abonnement aux webhooks (voir README).
CALENDLY_API_TOKEN=""

# Clé de signature renvoyée à la création de l'abonnement webhook.
# Laisser vide en local désactive la vérification de signature.
CALENDLY_WEBHOOK_SIGNING_KEY=""

# =============================================================================
# Resend — emails transactionnels
# Sans clé, les envois sont simplement journalisés dans la console.
# =============================================================================
RESEND_API_KEY=""
EMAIL_FROM="English with Lea <bonjour@ton-domaine.fr>"

# =============================================================================
# Cron Vercel — rappels de séance J-3 / J-1 / H-1
# Chaîne aléatoire ; Vercel l'envoie en en-tête Authorization: Bearer <valeur>.
# =============================================================================
CRON_SECRET=""
